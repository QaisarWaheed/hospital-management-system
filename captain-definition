{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM php:8.2-apache",
    "RUN docker-php-ext-install pdo pdo_mysql mysqli",
    "RUN a2enmod rewrite",
    "RUN sed -i 's/ServerName.*//' /etc/apache2/apache2.conf || true",
    "COPY . /var/www/html/",
    "RUN find /var/www/html -name 'php.ini' -delete || true",
    "RUN chown -R www-data:www-data /var/www/html",
    "EXPOSE 80"
  ]
}